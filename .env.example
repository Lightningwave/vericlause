# VeriClause – copy to .env and fill in your keys

# Supabase (free tier) – authentication
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LlamaCloud / LlamaParse – PDF parsing (replaces pdf-parse; supports complex/scanned docs)
LLAMA_CLOUD_API_KEY=

# OpenAI – primary LLM (gpt-4o-mini) + embeddings (text-embedding-3-small)
OPENAI_API_KEY=

# Groq (free) – fallback LLM for RAG verdicts when OpenAI fails
GROQ_API_KEY=

# Pinecone (free tier) – vector database for law chunks
PINECONE_API_KEY=
PINECONE_INDEX=vericlause-laws

# Azure speech (free tier) – for interview (please register for an acct for key)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# --- API hardening (optional; sensible defaults in code) ---
# Max JSON body for LLM routes (bytes). Default: 1048576 (1 MiB).
# MAX_JSON_BODY_BYTES=

# Max PDF/DOCX upload size (bytes). Default: 15728640 (15 MiB).
# MAX_UPLOAD_BYTES=

# In-memory rate limits (per user, per process). Use Redis/Upstash in production multi-instance.
# RATE_LIMIT_LLM_WINDOW_MS=900000
# RATE_LIMIT_LLM_MAX=40
# RATE_LIMIT_UPLOAD_WINDOW_MS=3600000
# RATE_LIMIT_UPLOAD_MAX=60
# RATE_LIMIT_PROFILE_WINDOW_MS=900000
# RATE_LIMIT_PROFILE_MAX=30
# RATE_LIMIT_AZURE_WINDOW_MS=60000
# RATE_LIMIT_AZURE_MAX=30
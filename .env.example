# VeriClause — Environment Variables Example
# Copy this to .env.local and fill in your keys

# App Config
NEXT_PUBLIC_APP_URL=https://vericlause.vercel.app

# Stripe (Test Mode keys start with sk_test_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase (Auth & Database)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI Models (Go directly to providers to get these)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# LlamaCloud (PDF Parsing)
LLAMA_CLOUD_API_KEY=

# Pinecone (Vector Search)
PINECONE_API_KEY=
PINECONE_INDEX=vericlause-laws

# ElevenLabs (Interview Voice AI)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_SOPHIA_AGENT_ID=
